# ============================================================
# .env.example — Copy this to .env and fill in real values
# Run on the server: cp .env.example .env && nano .env
# ============================================================

# Docker Compose project namespace (keeps container names unique)
COMPOSE_PROJECT_NAME=antigravity-chatapp

# REQUIRED: JWT signing secret
# Generate a secure value with: openssl rand -hex 64
JWT_SECRET=replace-this-with-a-64-char-random-string

# REQUIRED: MySQL root password
# Use a strong password — this secures your database
MYSQL_ROOT_PASSWORD=replace-this-with-a-strong-password

# OPTIONAL: Comma-separated allowed CORS origins
APP_CORS_ORIGINS=https://mychatsweb.tech

# OPTIONAL: Email (password reset + verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@mychatsweb.tech
APP_FRONTEND_URL=https://mychatsweb.tech
REQUIRE_EMAIL_VERIFICATION=false

# OPTIONAL: Push notifications (FCM) — configure when mobile app is ready
# FCM_SERVER_KEY=
